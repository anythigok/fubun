{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "required": [
    "actor",
    "adapter",
    "data",
    "id",
    "occurred_at",
    "privacy",
    "received_at",
    "source",
    "spec_version",
    "type"
  ],
  "properties": {
    "actor": {
      "$ref": "#/definitions/Actor"
    },
    "adapter": {
      "$ref": "#/definitions/AdapterIdentity"
    },
    "context": {
      "anyOf": [
        {
          "$ref": "#/definitions/ContextReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "$ref": "#/definitions/EventData"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string"
    },
    "privacy": {
      "$ref": "#/definitions/PrivacyClass"
    },
    "received_at": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "spec_version": {
      "type": "string"
    },
    "type": {
      "$ref": "#/definitions/EventType"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Actor": {
      "type": "string",
      "enum": [
        "user",
        "fubun",
        "system",
        "imported"
      ]
    },
    "AdapterIdentity": {
      "type": "object",
      "required": [
        "id",
        "instance_id",
        "sequence_no",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence_no": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ContextReference": {
      "type": "object",
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "EventData": {
      "description": "Event payloads are intentionally small and semantic.  Raw URLs, paths, titles, tab identifiers, and file names are not representable here.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "counter",
            "kind",
            "label"
          ],
          "properties": {
            "counter": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "enum": [
                "synthetic"
              ]
            },
            "label": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "resource_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "browser.resource.opened"
              ]
            },
            "resource_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "resource_id"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "vscode.workspace.opened"
              ]
            },
            "resource_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "dev.fubun.dev.synthetic.v1",
        "dev.fubun.browser.resource.opened.v1",
        "dev.fubun.vscode.workspace.opened.v1"
      ]
    },
    "PrivacyClass": {
      "type": "string",
      "enum": [
        "normal",
        "sensitive"
      ]
    }
  }
}
