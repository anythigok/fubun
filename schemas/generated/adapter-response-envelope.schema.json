{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdapterResponseEnvelope",
  "type": "object",
  "required": [
    "action_execution_id",
    "body",
    "protocol_version",
    "request_id"
  ],
  "properties": {
    "action_execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "body": {
      "$ref": "#/definitions/AdapterResponseBody"
    },
    "protocol_version": {
      "$ref": "#/definitions/ProtocolVersion"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ActionResult": {
      "type": "object",
      "required": [
        "redacted_message",
        "result_code",
        "status"
      ],
      "properties": {
        "redacted_message": {
          "type": "string"
        },
        "result_code": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/AdapterActionStatus"
        }
      },
      "additionalProperties": false
    },
    "AdapterActionStatus": {
      "type": "string",
      "enum": [
        "succeeded",
        "skipped",
        "failed"
      ]
    },
    "AdapterEventEmitRequest": {
      "type": "object",
      "required": [
        "occurred_at",
        "resource_id",
        "sequence_no",
        "type"
      ],
      "properties": {
        "occurred_at": {
          "type": "string"
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence_no": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "type": {
          "$ref": "#/definitions/EventType"
        }
      },
      "additionalProperties": false
    },
    "AdapterResponseBody": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "data",
            "kind"
          ],
          "properties": {
            "data": {
              "$ref": "#/definitions/ActionResult"
            },
            "kind": {
              "type": "string",
              "enum": [
                "action.result"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "data",
            "kind"
          ],
          "properties": {
            "data": {
              "$ref": "#/definitions/AdapterStatusSnapshot"
            },
            "kind": {
              "type": "string",
              "enum": [
                "adapter.status"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "data",
            "kind"
          ],
          "properties": {
            "data": {
              "$ref": "#/definitions/AdapterEventEmitRequest"
            },
            "kind": {
              "type": "string",
              "enum": [
                "event.emit"
              ]
            }
          }
        }
      ]
    },
    "AdapterStatusSnapshot": {
      "type": "object",
      "required": [
        "desktop_entry_ids",
        "tools"
      ],
      "properties": {
        "desktop_entry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "permitted_resource_ids": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AdapterToolStatus"
          }
        }
      },
      "additionalProperties": false
    },
    "AdapterToolStatus": {
      "type": "object",
      "required": [
        "available",
        "name"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EventType": {
      "type": "string",
      "enum": [
        "dev.fubun.dev.synthetic.v1",
        "dev.fubun.browser.resource.opened.v1",
        "dev.fubun.vscode.workspace.opened.v1"
      ]
    },
    "ProtocolVersion": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "minor": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    }
  }
}
